    <string name="info_title">Loungo is a browser for Android TV.</string>
    <string name="info_sub">This app lets you control Loungo on your TV from your phone.</string>
    <string name="info_light">Very light.</string>
    <string name="info_simple">Very simple.</string>
    <string name="info_fast">Very fast.</string>
    <string name="info_on_tv">On your TV, Loungo is</string>
    <string name="card1_title">Smooth even on weak TVs.</string>
    <string name="card1_b1_t">Closing it really closes it.</string>
    <string name="card1_b1">Nothing runs in the background, and it does not start when the TV turns on.</string>
    <string name="card1_b2_t">Your TV\'s own hardware plays the video.</string>
    <string name="card1_b2">Only qualities the TV can decode in hardware are offered, so the processor stays calm and playback stays smooth.</string>
    <string name="card1_b3_t">One page, no extra load.</string>
    <string name="card1_b3">No tabs, by design. When the cursor rests, the app rests too.</string>
    <string name="card1_b4_t">It lightens itself when the TV struggles.</string>
    <string name="card1_b4">If a page starts to stutter, visual effects turn off automatically.</string>
    <string name="card2_title">Finds the video on any page.</string>
    <string name="card2_body">One press opens it in a full-screen player: subtitles, audio language, quality and resume.</string>
    <string name="card3_title">Calm, ad-free browsing.</string>
    <string name="card3_body">Ads and trackers are blocked; unwanted pop-ups and redirects are stopped.</string>
    <string name="card4_title">No account, no tracking.</string>
    <string name="card4_body">Everything stays on your home network.</string>
    <string name="info_phone_title">Phone control</string>
    <string name="info_phone_body">Trackpad, keyboard, volume and player controls. Works with the TV remote alone, too.</string>
    <string name="info_install_title">Install Loungo on your TV</string>
    <string name="info_supported_t">Is your TV supported?</string>
    <string name="info_supported">Loungo runs on Android TV and Google TV, including most Sony, TCL, Philips and Xiaomi models, Chromecast and Android TV boxes. It does not run on Samsung (Tizen) or LG (webOS) TVs.</string>
    <string name="info_opt1_t">Option 1: from the TV.</string>
    <string name="info_opt1">Open Google Play on the TV, search for \"Loungo\" and press Install.</string>
    <string name="info_opt2_t">Option 2: from your phone.</string>
    <string name="info_opt2">Open Loungo\'s Play page with the button below and choose your TV in the install options. The TV must be signed in to the same Google account as this phone.</string>
    <string name="info_install_btn">Install on TV</string>
    <string name="info_connect_title">How to connect</string>
    <string name="info_connect_1">1. Put the phone and the TV on the same Wi-Fi network.</string>
    <string name="info_connect_2">2. Open Loungo on the TV. This screen turns into the remote by itself.</string>
    <string name="remote_rate_limited">Too many attempts. Try again in a minute.</string>
    <string name="tv_requires_android12">Loungo on the TV needs Android 12 or newer.</string>
    <string name="webview_outdated">Android System WebView is old; some sites may not work properly. Update it from the Play Store.</string>
